; Engine configuration file.
; Hand-edited settings are documented in CLAUDE.md. Godot may reorder keys on save; that is fine.

config_version=5

[application]

config/name="Stick Swing"
config/description="Reusable 2D Android game template."
config/version="0.1.0"
run/main_scene="res://game/ui/splash.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.105882, 0.12549, 0.2, 1)
boot_splash/show_image=false

[autoload]

EventBus="*res://addons/studio_core/core/event_bus.gd"
SaveManager="*res://addons/studio_core/core/save_manager.gd"
AudioManager="*res://addons/studio_core/core/audio_manager.gd"
Settings="*res://addons/studio_core/core/settings.gd"
Haptics="*res://addons/studio_core/core/haptics.gd"
TouchInput="*res://addons/studio_core/core/touch_input.gd"
SceneRouter="*res://addons/studio_core/core/scene_router.gd"
Ads="*res://addons/studio_core/services/ads.gd"
Purchases="*res://addons/studio_core/services/purchases.gd"
Analytics="*res://addons/studio_core/services/analytics.gd"
DevTools="*res://addons/studio_core/core/dev_tools.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_call_argument=0

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

theme/custom="res://assets/theme/studio_theme.tres"
common/drop_mouse_on_gui_input_disabled=true

[input]

jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194320,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":80,"key_label":0,"unicode":112,"location":0,"echo":false,"script":null)
]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="world"
2d_physics/layer_3="hazard"
2d_physics/layer_4="pickup"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.105882, 0.12549, 0.2, 1)
2d/snap/snap_2d_transforms_to_pixel=false
