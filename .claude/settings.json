{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["godot", "mobile"],
  "permissions": {
    "allow": [
      "Bash(tools/build.sh:*)",
      "Bash(./tools/build.sh:*)",
      "Bash(powershell -File tools/build.ps1:*)",
      "Bash(pwsh -File tools/build.ps1:*)",
      "Bash(node tools/new_game.mjs:*)",
      "Bash(node tools/version.mjs show)",
      "Bash(godot --headless:*)",
      "Bash(godot --version)",
      "Bash(gdlint:*)",
      "Bash(gdformat:*)",
      "Bash(adb devices)",
      "Bash(adb logcat:*)",
      "mcp__godot__get_godot_version",
      "mcp__godot__get_project_info",
      "mcp__godot__get_debug_output",
      "mcp__godot__run_project",
      "mcp__godot__stop_project",
      "mcp__mobile__mobile_list_available_devices",
      "mcp__mobile__mobile_take_screenshot",
      "mcp__mobile__mobile_list_elements_on_screen",
      "mcp__mobile__mobile_get_screen_size",
      "mcp__mobile__mobile_get_device_logs"
    ],
    "deny": [
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/export_credentials.cfg)",
      "Edit(.godot/**)",
      "Edit(addons/gut/**)",
      "Edit(android/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_paths.mjs\"", "timeout": 15 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint_gd.mjs\"", "timeout": 60 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_tests.mjs\"", "timeout": 600 }]
      }
    ]
  }
}
